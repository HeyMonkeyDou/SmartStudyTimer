<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#0FB866"
                android:startColor="#8EF1B2" />
        </shape>
    </item>

    <item android:gravity="top|start" android:left="-100dp" android:top="-80dp">
        <shape android:shape="oval">
            <size
                android:width="260dp"
                android:height="260dp" />
            <solid android:color="#28FFFFFF" />
        </shape>
    </item>

    <item android:gravity="center|end" android:right="-120dp">
        <shape android:shape="oval">
            <size
                android:width="280dp"
                android:height="280dp" />
            <solid android:color="#2200723D" />
        </shape>
    </item>

    <item
        android:bottom="380dp"
        android:left="40dp"
        android:right="40dp"
        android:top="150dp">
        <shape android:shape="rectangle">
            <corners android:radius="120dp" />
            <solid android:color="#17FFFFFF" />
        </shape>
    </item>

    <item
        android:bottom="108dp"
        android:left="30dp"
        android:right="30dp"
        android:top="260dp">
        <shape android:shape="rectangle">
            <corners android:radius="40dp" />
            <gradient
                android:angle="90"
                android:endColor="#14FFFFFF"
                android:startColor="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
