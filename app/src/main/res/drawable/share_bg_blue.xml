<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#2D7BFF"
                android:startColor="#A7C7FF" />
        </shape>
    </item>

    <item android:gravity="top|end" android:right="-90dp" android:top="-120dp">
        <shape android:shape="oval">
            <size
                android:width="340dp"
                android:height="340dp" />
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>

    <item android:gravity="bottom|start" android:bottom="-110dp" android:left="-80dp">
        <shape android:shape="oval">
            <size
                android:width="320dp"
                android:height="320dp" />
            <solid android:color="#28114DAE" />
        </shape>
    </item>

    <item
        android:bottom="250dp"
        android:left="-30dp"
        android:right="-90dp"
        android:top="130dp">
        <rotate android:fromDegrees="-24">
            <shape android:shape="rectangle">
                <corners android:radius="30dp" />
                <solid android:color="#16FFFFFF" />
            </shape>
        </rotate>
    </item>

    <item
        android:bottom="110dp"
        android:left="34dp"
        android:right="34dp"
        android:top="260dp">
        <shape android:shape="rectangle">
            <corners android:radius="40dp" />
            <gradient
                android:angle="90"
                android:endColor="#14FFFFFF"
                android:startColor="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
