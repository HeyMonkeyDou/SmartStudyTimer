<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="10dp"
    android:paddingHorizontal="4dp">

    <!-- Red dot indicator -->
    <View
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_red_dot"
        android:layout_marginEnd="12dp" />

    <!-- Name and email -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRequestName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRequestSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Accept button (green check) -->
    <ImageButton
        android:id="@+id/btnAccept"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_check"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Accept"
        android:layout_marginStart="8dp" />

    <!-- Decline button (red X) -->
    <ImageButton
        android:id="@+id/btnDecline"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_close"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Decline"
        android:layout_marginStart="4dp" />

</LinearLayout>
