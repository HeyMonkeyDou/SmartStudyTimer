<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom RemoteViews layout for the study timer foreground notification.
  Shown as the "big" (expanded) content on the lock screen and in the shade.
  The standard notification header (app name, icon, timestamp) is added
  automatically by DecoratedCustomViewStyle above this view.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="6dp"
    android:paddingBottom="10dp">

    <!-- ── App name (replaces the system header removed with DecoratedCustomViewStyle) ── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SmartStudyTimer"
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginBottom="2dp" />

    <!-- ── Row: time remaining + distraction badge ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Large bold countdown -->
        <TextView
            android:id="@+id/notifTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="00:00:00"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:includeFontPadding="false" />

        <!-- Distraction count (hidden in Normal mode) -->
        <LinearLayout
            android:id="@+id/notifDistractionContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Distractions"
                android:textSize="10sp"
                android:textColor="#888888"
                android:gravity="center" />

            <TextView
                android:id="@+id/notifDistraction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/3"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFC107"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── Progress bar (amber) ── -->
    <ProgressBar
        android:id="@+id/notifProgress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/progress_amber" />

</LinearLayout>
