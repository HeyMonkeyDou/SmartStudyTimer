<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="36dp"
        app:title="Study Timer" />

    <!-- Scrollable content area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- homeContainer: background color is changed by updateUIState() -->
        <LinearLayout
            android:id="@+id/homeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="36dp"
            android:gravity="top|center_horizontal">

            <!-- Mode Selection -->
            <RadioGroup
                android:id="@+id/radioGroupMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <RadioButton
                    android:id="@+id/radioNormal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Normal"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/radioPomodoro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pomodoro"
                    android:layout_marginStart="20dp" />
            </RadioGroup>

            <!-- Timer Display -->
            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textSize="64sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Status -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mode: Normal"
                android:textSize="16sp"
                android:layout_marginBottom="24dp" />

            <!-- Time Input (Hours + Minutes) -->
            <LinearLayout
                android:id="@+id/layoutTimeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <!-- Hours input — hidden in Pomodoro mode -->
                <LinearLayout
                    android:id="@+id/layoutHoursInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputHours"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Hours"
                            android:inputType="number" />

                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Minutes input — always visible -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputMinutes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Minutes"
                            android:inputType="number" />

                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Pomodoro Options (only visible in Pomodoro mode) -->
            <LinearLayout
                android:id="@+id/layoutPomodoroOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="20dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pomodoro Rounds" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputRounds"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:hint="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distraction Limit (max 5)"
                    android:layout_marginTop="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputDistractionLimit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:hint="3" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Voice Command Button -->
            <Button
                android:id="@+id/btnVoiceCommand"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Tap to Speak"
                android:layout_marginBottom="16dp"
                app:icon="@drawable/ic_mic"
                app:iconPadding="2dp"
                app:iconGravity="textStart"
                app:iconTint="@color/icon_tint" />

            <!-- Timer Control Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnReset"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:enabled="false"
                    android:layout_marginEnd="8dp"
                    app:icon="@drawable/ic_reset"
                    app:iconPadding="2dp"
                    app:iconGravity="textStart"
                    app:iconTint="@color/icon_tint" />

                <Button
                    android:id="@+id/btnPause"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Pause"
                    android:enabled="false"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    app:icon="@drawable/ic_pause"
                    app:iconPadding="2dp"
                    app:iconGravity="textStart"
                    app:iconTint="@color/icon_tint" />

                <Button
                    android:id="@+id/btnStart"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Start"
                    android:layout_marginStart="8dp"
                    app:icon="@drawable/ic_play"
                    app:iconPadding="2dp"
                    app:iconGravity="textStart"
                    app:iconTint="@color/icon_tint" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>