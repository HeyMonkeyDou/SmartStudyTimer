<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="36dp"
        app:title="Friends" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- ── Add Friend ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Add Friend by Username"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputFriendUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Enter friend's username"
                android:inputType="textNoSuggestions" />

            <Button
                android:id="@+id/btnSendFriendRequest"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Send Friend Request" />

            <Button
                android:id="@+id/btnRefreshProfile"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Refresh" />

            <!-- ── Incoming Requests ── -->
            <TextView
                android:id="@+id/incomingRequestsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Incoming Friend Requests"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIncomingRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="No pending requests"
                android:textSize="14sp" />

            <!-- ── Friends Leaderboard ── -->
            <TextView
                android:id="@+id/friendsComparisonLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Friends Comparison"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFriendsComparison"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="No friends yet"
                android:textSize="14sp" />

            <!-- ── Remove Friend ── -->
            <TextView
                android:id="@+id/removeFriendLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Remove Friend by Username"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputRemoveFriendUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Enter friend's username"
                android:inputType="textNoSuggestions" />

            <Button
                android:id="@+id/btnRemoveFriend"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Remove Friend" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
