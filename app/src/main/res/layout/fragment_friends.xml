<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="36dp"
        app:title="Friends" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- ── My Username ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="My Username"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Display row: username text + Change button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMyUsername"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="(no username set)"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnChangeUsername"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Edit row: input + Save (shown when setting / changing) -->
            <LinearLayout
                android:id="@+id/usernameEditRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="visible">

                <EditText
                    android:id="@+id/inputNewUsername"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Set username (3‑20 chars, a‑z 0‑9 _)"
                    android:inputType="textNoSuggestions"
                    android:maxLength="20" />

                <Button
                    android:id="@+id/btnSetUsername"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Save" />

            </LinearLayout>

            <TextView
                android:id="@+id/usernameStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- ── Add Friend ── -->
            <TextView
                android:id="@+id/addFriendLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Add Friend by Username"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputFriendUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Enter friend's username"
                android:inputType="textNoSuggestions" />

            <Button
                android:id="@+id/btnSendFriendRequest"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Send Friend Request" />

            <Button
                android:id="@+id/btnRefreshProfile"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Refresh" />

            <!-- ── Incoming Requests ── -->
            <TextView
                android:id="@+id/incomingRequestsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Incoming Friend Requests"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIncomingRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="No pending requests"
                android:textSize="14sp" />

            <!-- ── Friends Leaderboard ── -->
            <TextView
                android:id="@+id/friendsComparisonLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Friends Comparison"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFriendsComparison"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="No friends yet"
                android:textSize="14sp" />

            <!-- ── Remove Friend ── -->
            <TextView
                android:id="@+id/removeFriendLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Remove Friend by Username"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputRemoveFriendUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Enter friend's username"
                android:inputType="textNoSuggestions" />

            <Button
                android:id="@+id/btnRemoveFriend"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Remove Friend" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
